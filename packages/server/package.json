{
  "name": "@astrolabe/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API, event log, projections, AI provider abstraction, prompt assembly",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsx watch --env-file-if-exists=../../.env src/http/serve.ts",
    "start": "node dist/http/serve.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts",
    "harness": "tsx --env-file-if-exists=../../.env src/harness/cli.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/fixtures/cli.ts seed",
    "reset": "tsx --env-file-if-exists=../../.env src/fixtures/cli.ts reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@astrolabe/rules": "*",
    "@astrolabe/shared": "*",
    "fastify": "^5.6.0",
    "postgres": "^3.4.0",
    "zod": "^4.1.0"
  }
}
