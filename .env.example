# Copy to .env (git-ignored). Read by the server's dev, migrate and harness
# scripts; a variable already set in the shell wins over this file.

# Local Postgres from `npm run db:up`.
DATABASE_URL=postgres://astrolabe:astrolabe@localhost:5433/astrolabe

# The Guide (D-119). Without a key, play starts paused (D-116).
ANTHROPIC_API_KEY=

# Optional: another Claude model (default claude-opus-5).
# ASTROLABE_CLAUDE_MODEL=claude-sonnet-5

# Optional: the scripted stub provider — no key, no tokens spent.
# ASTROLABE_AI_PROVIDER=stub

# PORT=3000

# Docker Compose on the server (D-154). DATABASE_URL above is ignored there:
# compose points the app at its own Postgres.
# POSTGRES_PASSWORD=
# ASTROLABE_PORT=3000
